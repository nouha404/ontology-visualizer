<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:test="http://example.org/test#"
    xml:base="http://example.org/test">

    <owl:Ontology rdf:about="http://example.org/test">
        <rdfs:label>Ontologie de Test Simple</rdfs:label>
        <rdfs:comment>Une petite ontologie pour tester l'application</rdfs:comment>
    </owl:Ontology>

    <!-- ===================== CLASSES ===================== -->
    
    <!-- Classe racine -->
    <owl:Class rdf:about="#Etre">
        <rdfs:label>Être</rdfs:label>
        <rdfs:comment>Tout ce qui existe</rdfs:comment>
    </owl:Class>

    <!-- Animal hérite de Etre -->
    <owl:Class rdf:about="#Animal">
        <rdfs:subClassOf rdf:resource="#Etre"/>
        <rdfs:label>Animal</rdfs:label>
        <rdfs:comment>Un être vivant qui peut se déplacer</rdfs:comment>
    </owl:Class>

    <!-- Plante hérite de Etre -->
    <owl:Class rdf:about="#Plante">
        <rdfs:subClassOf rdf:resource="#Etre"/>
        <rdfs:label>Plante</rdfs:label>
        <rdfs:comment>Un être vivant qui fait la photosynthèse</rdfs:comment>
    </owl:Class>

    <!-- Mammifere hérite de Animal -->
    <owl:Class rdf:about="#Mammifere">
        <rdfs:subClassOf rdf:resource="#Animal"/>
        <rdfs:label>Mammifère</rdfs:label>
        <rdfs:comment>Animal qui allaite ses petits</rdfs:comment>
    </owl:Class>

    <!-- Oiseau hérite de Animal -->
    <owl:Class rdf:about="#Oiseau">
        <rdfs:subClassOf rdf:resource="#Animal"/>
        <rdfs:label>Oiseau</rdfs:label>
        <rdfs:comment>Animal avec des plumes</rdfs:comment>
    </owl:Class>

    <!-- Chien hérite de Mammifere -->
    <owl:Class rdf:about="#Chien">
        <rdfs:subClassOf rdf:resource="#Mammifere"/>
        <rdfs:label>Chien</rdfs:label>
        <rdfs:comment>Meilleur ami de l'homme</rdfs:comment>
    </owl:Class>

    <!-- Chat hérite de Mammifere -->
    <owl:Class rdf:about="#Chat">
        <rdfs:subClassOf rdf:resource="#Mammifere"/>
        <rdfs:label>Chat</rdfs:label>
        <rdfs:comment>Félin domestique</rdfs:comment>
    </owl:Class>

    <!-- Aigle hérite de Oiseau -->
    <owl:Class rdf:about="#Aigle">
        <rdfs:subClassOf rdf:resource="#Oiseau"/>
        <rdfs:label>Aigle</rdfs:label>
        <rdfs:comment>Grand rapace</rdfs:comment>
    </owl:Class>

    <!-- Arbre hérite de Plante -->
    <owl:Class rdf:about="#Arbre">
        <rdfs:subClassOf rdf:resource="#Plante"/>
        <rdfs:label>Arbre</rdfs:label>
        <rdfs:comment>Grande plante avec un tronc</rdfs:comment>
    </owl:Class>

    <!-- Fleur hérite de Plante -->
    <owl:Class rdf:about="#Fleur">
        <rdfs:subClassOf rdf:resource="#Plante"/>
        <rdfs:label>Fleur</rdfs:label>
        <rdfs:comment>Plante à fleurs</rdfs:comment>
    </owl:Class>

    <!-- ===================== OBJECT PROPERTIES ===================== -->

    <!-- mange -->
    <owl:ObjectProperty rdf:about="#mange">
        <rdfs:label>mange</rdfs:label>
        <rdfs:domain rdf:resource="#Animal"/>
        <rdfs:range rdf:resource="#Etre"/>
        <rdfs:comment>Relation de prédation ou alimentation</rdfs:comment>
    </owl:ObjectProperty>

    <!-- estMangePar (inverse de mange) -->
    <owl:ObjectProperty rdf:about="#estMangePar">
        <rdfs:label>est mangé par</rdfs:label>
        <owl:inverseOf rdf:resource="#mange"/>
    </owl:ObjectProperty>

    <!-- habite -->
    <owl:ObjectProperty rdf:about="#habite">
        <rdfs:label>habite</rdfs:label>
        <rdfs:domain rdf:resource="#Animal"/>
        <rdfs:comment>Où vit l'animal</rdfs:comment>
    </owl:ObjectProperty>

    <!-- amiAvec (symétrique) -->
    <owl:ObjectProperty rdf:about="#amiAvec">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label>ami avec</rdfs:label>
        <rdfs:domain rdf:resource="#Animal"/>
        <rdfs:range rdf:resource="#Animal"/>
    </owl:ObjectProperty>

    <!-- ===================== DATATYPE PROPERTIES ===================== -->

    <!-- nom -->
    <owl:DatatypeProperty rdf:about="#nom">
        <rdfs:label>nom</rdfs:label>
        <rdfs:domain rdf:resource="#Etre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- age -->
    <owl:DatatypeProperty rdf:about="#age">
        <rdfs:label>âge</rdfs:label>
        <rdfs:domain rdf:resource="#Animal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <!-- poids -->
    <owl:DatatypeProperty rdf:about="#poids">
        <rdfs:label>poids (kg)</rdfs:label>
        <rdfs:domain rdf:resource="#Animal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

</rdf:RDF>
